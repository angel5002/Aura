# AURA nodo - configuracion por defecto. ESTE ARCHIVO VA A GIT: NUNCA poner aqui SSID, contrasenas,
# correo/clave del dispositivo ni la clave local. Las credenciales viven en NVS y se cargan con
# C:\aura\analisis\cargar_credenciales.py (ver docs/arquitectura_dos_vias.md).

# --- Flash y particiones: 4 MB, dos ranuras OTA de 1,5 MB, NVS de 64 KB, coredump ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xa000
# Vuelta automatica a la version anterior si la nueva no se marca como valida.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- Compilacion: -Os; aserciones habilitadas (valor por defecto, se mantiene) ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Consola por el USB nativo (USB Serial/JTAG) de la FireBeetle 2 ESP32-C5 ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# --- WiFi y CSI (igual que wifi_sensing_demo; buffers RX en 128 hasta la prueba D9) ---
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_SENSING_DEFAULT_PRESENCE_SENSITIVITY=250
CONFIG_ESP_WIFI_SENSING_DEMO_LED_GPIO=15

# --- Red: IPv6 SE MANTIENE porque esp_wifi_sensing lo exige (usa ip_addr_t.u_addr en su ping;
# con CONFIG_LWIP_IPV6=n no compila: verificado el 22/10/2026). Sockets para UDP, OTA, HTTPS, SNTP y ping ---
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# Resincroniza cada 15 min: la deriva del reloj de la placa (~20 ppm) queda por debajo de 20 ms.
CONFIG_LWIP_SNTP_UPDATE_DELAY=900000

# --- TLS: bundle COMPLETO de certificados (verificacion obligatoria) y buffers dinamicos ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# --- 0.1.3 (23/10/2026): memoria de recepcion WiFi (diagnostico P2_012: 3 episodios con la memoria casi agotada,
# atribuidos a buffers de recepcion retenidos). Guia de rendimiento de Espressif (wifi.rst): RX_BA_WIN = min(2 x
# estaticos, dinamicos) y TCP_WND_DEFAULT (KB) = dinamicos. Con 12 buffers una rafaga retiene como maximo ~28 KB.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_LWIP_TCP_WND_DEFAULT=12288
# El certificado del servidor no se necesita tras el handshake (2-4 KB menos con la base conectada). TLS 1.3 sigue off.
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
# Diagnostico de la causa (uso de CPU por tarea y estadisticas de lwIP; se puede quitar al terminar el diagnostico)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_LWIP_STATS=y
